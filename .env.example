# --- Supabase (required) -----------------------------------------------------
# Project URL + anon key: Supabase dashboard → Project Settings → API.
# Until the real AppointEase Supabase project is created, leave the placeholder
# values: the site runs in DEMO MODE (public pages render the seeded demo
# business, no data is persisted).
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Service role key — server only, NEVER expose to the browser.
# Used by the reminder cron route and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Reminders ---------------------------------------------------------------
# Protects /api/cron/reminders. Set any long random string.
CRON_SECRET=change-me

# Email provider (optional in v1): Resend API key. Without it, outgoing email
# is logged to the server console instead of sent (nothing is faked as sent).
RESEND_API_KEY=
EMAIL_FROM=AppointEase <reminders@appointease.io>

# SMS provider (Phase 2): Twilio. Until these are set, SMS reminders are
# logged as "would send" and marked skipped — never reported as delivered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Web Push (optional) -----------------------------------------------------
# Generate a VAPID key pair once (e.g. `npx web-push generate-vapid-keys`).
# Without these, push delivery is env-gated OFF and recorded as skipped in
# notifications_log — email/SMS alerts still work. The public key is safe to
# expose; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@appointease.io

# --- Billing: Stripe (businesses subscribe to AppointEase) -------------------
# Plans (src/lib/plans.ts): Solo $29.99/mo · Team $49.99/mo · Business
# $149.99/mo, after a 30-day free trial with no card upfront. Customers who
# book never pay — only businesses subscribe.
# Until STRIPE_SECRET_KEY and the three monthly price IDs below are set,
# billing runs in BILLING-NOT-CONFIGURED mode: trials keep running, booking
# stays live, and the owner Settings page shows subscribe buttons disabled
# with a plain note. Nothing charges anyone in that mode.
# Secret key — server only, NEVER expose to the browser.
STRIPE_SECRET_KEY=
# Webhook signing secret (Stripe dashboard → Developers → Webhooks, for the
# endpoint <site>/api/stripe/webhook) — server only.
STRIPE_WEBHOOK_SECRET=
# Publishable key — safe to expose; reserved for future client-side use.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# One recurring monthly price per plan (Stripe dashboard → Products).
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
# Optional: recurring ANNUAL prices (annual = 2 months free). The annual
# toggle appears in Settings only when all three are set.
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_BUSINESS_ANNUAL=
