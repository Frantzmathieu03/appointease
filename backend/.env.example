# AppointEase backend environment — copy to ".env" and fill in real values.
# NEVER commit a filled .env (it is gitignored). Placeholders only here.

# --- Supabase Postgres (replaces the old MONGO_URI) ---
# Direct connection string from the Supabase project:
# Settings -> Database -> Connection string (port 5432).
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-server-only>

# --- Auth ---
JWT_SECRET=<random-secret-keep-the-existing-production-value-at-cutover>
FRONTEND_URL=https://appointease.io

# --- Server ---
PORT=8000
KEEP_ALIVE_URL=https://appointease-03wm.onrender.com/api/health

# --- Stripe (business subscriptions) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE=
STRIPE_PRO_PRICE=
STRIPE_ENTERPRISE_PRICE=

# --- Reminders / password reset ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
RESEND_API_KEY=

# --- Google sign-in (phase 2 repair) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
